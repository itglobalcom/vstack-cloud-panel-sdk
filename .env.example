# Copy to .env and fill in real values: cp .env.example .env
# The Makefile loads .env automatically (-include .env) and exports the vars,
# so `make example RESOURCE=...` picks them up.

# API token for your vStack Cloud Panel project (created in the panel).
API_KEY=your-api-token-here

# API base URL.
API_URL=https://api.example.com
